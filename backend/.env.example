# OpenAI 兼容 API 配置。DeepSeek 示例：https://api.deepseek.com
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 手机访问保护：务必替换为强随机字符串；HTTPS 部署时设为 true。
WORKBENCH_PASSWORD=请替换为强密码
WORKBENCH_SESSION_SECRET=请替换为至少32位随机字符串
COOKIE_SECURE=true

# 可选：自定义记忆文件夹（默认是 backend/memories）
# MEMORY_DIR=

# Claude Code 控制面板（可选）。先在本机执行 claude auth login。
# 用分号分隔工作目录，格式：显示名称=绝对路径；为空时只允许本项目目录。
# CLAUDE_WORKSPACES=我的项目=C:\\Projects\\my-project
# CLAUDE_COMMAND=claude
